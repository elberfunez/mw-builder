# Copy this file to .env and fill in your key.
# The key is only used in the browser (Vite exposes VITE_* vars to the client bundle).
# Keep .env out of version control — it is already in .gitignore.

VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Pricing sheet: publish your Google Sheet to web as CSV (File → Share → Publish to web → CSV)
# then paste the URL here. If omitted, hardcoded default prices are used.
VITE_PRICING_SHEET_URL=
